manifest {
    name        = 'workflow-dev-example'
    description = 'Minimal FastQC example workflow shipped by the template, for 02_workflow_dev'
    mainScript  = 'main.nf'
    version     = '0.1'
}

// Default workflow parameters
// Override them in the params.yml located in the analyses directories.
params {

    // Workflow inputs
    samples = ''
}

profiles {

    // Local development (laptop, no HPC): run with Docker.
    local {
        process.executor = 'local'
        docker.enabled = true
    }

    // Clusters covered by nf-core's maintained institutional configs -
    // see docs/advice/nextflow_workflow.md for why these are preferred
    // over hand-written profiles.
    pelle {
        includeConfig 'https://raw.githubusercontent.com/nf-core/configs/master/conf/uppmax.config'
        params.project = ''
    }
    bianca {
        includeConfig 'https://raw.githubusercontent.com/nf-core/configs/master/conf/uppmax.config'
        params.project = ''
    }
    dardel {
        includeConfig 'https://raw.githubusercontent.com/nf-core/configs/master/conf/pdc_kth.config'
        params.project = ''
    }
    arrhenius {
        includeConfig 'https://raw.githubusercontent.com/nf-core/configs/master/conf/naiss.config'
        params.project = ''
    }

    // No maintained nf-core config for NAC; still Slurm-based, no
    // project allocation needed.
    nac {
        process {
            executor = 'slurm'
            scratch = '$TMPDIR' // check the cluster's actual scratch variable
        }
        apptainer.enabled = true
    }
}

// Tool-specific resource/argument overrides
includeConfig 'configs/compute_resources.config'
includeConfig 'configs/modules.config'
