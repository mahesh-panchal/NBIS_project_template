manifest {
    name        = 'workflow-dev-example'
    description = 'Minimal FastQC example workflow shipped by the template, for 02_workflow_dev'
    mainScript  = 'main.nf'
    version     = '0.1'
}

// Default workflow parameters
// Override them in the params.yml located in the analyses directories.
params {

    // Workflow inputs
    samples = ''
}

profiles {

    // Local development (laptop, no HPC): run with Docker.
    local {
        process.executor = 'local'
        docker.enabled = true
    }

    // Clusters covered by nf-core's maintained institutional configs -
    // see docs/advice/nextflow_workflow.md for why these are preferred
    // over hand-written profiles.
    pelle {
        includeConfig 'https://raw.githubusercontent.com/nf-core/configs/master/conf/uppmax.config'
        params.project = ''
    }
    // Bianca has no general internet access (see docs/advice/glossary.md
    // #clusters), so unlike the other clusters above this can't
    // `includeConfig` nf-core's institutional config directly over
    // https - it uses a locally vendored copy instead (re-sync
    // instructions in conf/bianca_uppmax.config), and pins each
    // module's container to a local file pre-pulled on a machine with
    // internet and transferred onto Bianca. See
    // docs/advice/nextflow_workflow.md#running-on-bianca.
    bianca {
        includeConfig 'conf/bianca_uppmax.config'
        params.project = ''

        process {
            withName: 'FASTQC' {
                container = "${System.getenv('NXF_APPTAINER_CACHEDIR')}/fastqc-0.12.1--hdfd78af_0.sif"
            }
        }
    }
    dardel {
        includeConfig 'https://raw.githubusercontent.com/nf-core/configs/master/conf/pdc_kth.config'
        params.project = ''
    }
    arrhenius {
        includeConfig 'https://raw.githubusercontent.com/nf-core/configs/master/conf/naiss.config'
        params.project = ''
    }

    // No maintained nf-core config for NAC; still Slurm-based, no
    // project allocation needed.
    nac {
        process {
            executor = 'slurm'
            scratch = '$TMPDIR' // check the cluster's actual scratch variable
        }
        apptainer.enabled = true
    }
}

// Tool-specific resource/argument overrides
includeConfig 'conf/compute_resources.config'
includeConfig 'conf/modules.config'
